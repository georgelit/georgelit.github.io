# GLIT Circle — Apache-Konfiguration fuer united-domains Webspace

# --- Alte Adressen der Vorgaenger-Website ---
# Die alte Fassung war ein Onepager je Sprache: /index.html und /de/ auf Deutsch,
# /en/ auf Englisch, dazu je zwei Rechtsseiten mit .html-Endung. Diese neun
# Adressen sind indexiert und wuerden ohne Weiterleitung in den 404 laufen.
# Ziele absolut und mit https, damit aus www oder http nur ein Sprung wird.

# Zeichensatz auch im HTTP-Kopf nennen. Ohne Angabe deuten einfache Abrufer
# text/html regelkonform als ISO-8859-1 und zerlegen jeden Umlaut. Browser
# lesen die Angabe aus dem Dokument, gescrapte Zulieferpfade nicht.
AddDefaultCharset UTF-8

RewriteEngine On

# Viele Crawler und Pruefwerkzeuge probieren zuerst den kanonischen Namen
# /sitemap.xml. Interner Rewrite statt Weiterleitung, damit auch Abrufer ohne
# Redirect-Verfolgung die Sitemap zu sehen bekommen.
RewriteRule ^sitemap\.xml$ /sitemap-index.xml [L]

RewriteRule ^de/?$                    https://glitcircle.com/ [R=301,L]
RewriteRule ^de/index\.html$          https://glitcircle.com/ [R=301,L]
RewriteRule ^index\.html$             https://glitcircle.com/ [R=301,L]
RewriteRule ^en/index\.html$          https://glitcircle.com/en/ [R=301,L]
RewriteRule ^(?:de/)?legal-notice\.html$    https://glitcircle.com/impressum/ [R=301,L]
RewriteRule ^(?:de/)?privacy-policy\.html$  https://glitcircle.com/datenschutz/ [R=301,L]
RewriteRule ^en/legal-notice\.html$   https://glitcircle.com/en/legal-notice/ [R=301,L]
RewriteRule ^en/privacy-policy\.html$ https://glitcircle.com/en/privacy-policy/ [R=301,L]

# --- Kanonische Adresse: www und http auf https://glitcircle.com ---
# glitcircle.de ist registriert, aber nicht die Adresse der Marke. Sie zeigt
# auf denselben Webspace und leitet mit Pfad weiter, damit kein zweiter
# Auftritt mit gleichem Inhalt entsteht. Die Regel steht hinter den Regeln
# fuer die alten Adressen, damit auch von dort nur ein Sprung noetig ist.
RewriteCond %{HTTP_HOST} ^(www\.)?glitcircle\.de$ [NC]
RewriteRule ^(.*)$ https://glitcircle.com/$1 [R=301,L]

RewriteCond %{HTTP_HOST} ^www\.glitcircle\.com$ [NC]
RewriteRule ^(.*)$ https://glitcircle.com/$1 [R=301,L]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP_HOST} ^glitcircle\.com$ [NC]
RewriteRule ^(.*)$ https://glitcircle.com/$1 [R=301,L]

# --- Fehlerseite ---
ErrorDocument 404 /404.html

# --- Kompression ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml application/xml
</IfModule>

# --- Cache: Assets mit Hash im Namen lange, HTML kurz ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 10 minutes"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType video/mp4 "access plus 1 month"
  ExpiresByType video/webm "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
</IfModule>

# --- Sicherheit ---
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>
